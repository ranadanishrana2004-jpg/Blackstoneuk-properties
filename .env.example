# ---- Required in production (Render) ----
DATABASE_URL=            # Render Postgres connection string (set automatically by render.yaml)
SITE_URL=https://www.example.co.uk
ADMIN_EMAIL=             # first owner account, created on first start only
ADMIN_PASSWORD=          # min 12 chars; change it from the workspace after first sign-in

# ---- Email (Brevo) ----
BREVO_API_KEY=           # Brevo > SMTP & API > API keys
MAIL_FROM=info@example.co.uk     # must be a verified sender/domain in Brevo
NOTIFY_EMAIL=            # where new enquiries are sent (defaults to CONTACT_EMAIL)
CONTACT_EMAIL=info@example.co.uk

# ---- Shown on the website only when set ----
CONTACT_PHONE=
WHATSAPP_NUMBER=         # international format, digits only, e.g. 447700900123
OFFICE_ADDRESS=
OPENING_HOURS=Mon–Fri 9:00–17:30 · Sat 10:00–14:00
COMPANY_NUMBER=
REGISTERED_OFFICE=
VAT_NUMBER=
ICO_NUMBER=
REDRESS_SCHEME=          # e.g. The Property Ombudsman / Property Redress Scheme + membership no.
CMP_SCHEME=              # Client Money Protection scheme (lettings)
FINANCE_STATEMENT=       # FCA / introducer / appointed-representative wording, once confirmed
